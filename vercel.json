{
  "version": 2,
  "buildCommand": "rm -rf build public && cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "npm install && cd frontend && npm install",
  "framework": null,
  "functions": {
    "api/chat/stream.js": { "maxDuration": 120 },
    "api/chat.js": { "maxDuration": 120 }
  },
  "rewrites": [
    { "source": "/chatbot-demo/api/chat/stream", "destination": "/api/chat/stream" },
    { "source": "/chatbot-demo/api/chat", "destination": "/api/chat" },
    { "source": "/chatbot-demo/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/chatbot-demo/fonts/:path*", "destination": "/fonts/:path*" },
    { "source": "/chatbot-demo/scenic/:path*", "destination": "/scenic/:path*" },
    { "source": "/chatbot-demo/exa-logomark-blue.svg", "destination": "/exa-logomark-blue.svg" },
        { "source": "/chatbot-demo/exa-logomark-white.svg", "destination": "/exa-logomark-white.svg" },
        { "source": "/chatbot-demo/exa_logo.png", "destination": "/exa_logo.png" },
        { "source": "/chatbot-demo/favicon.svg", "destination": "/favicon.svg" },
        { "source": "/chatbot-demo/favicon.png", "destination": "/favicon.png" },
        { "source": "/chatbot-demo", "destination": "/index.html" },
    { "source": "/chatbot-demo/:path*", "destination": "/index.html" }
  ]
}
